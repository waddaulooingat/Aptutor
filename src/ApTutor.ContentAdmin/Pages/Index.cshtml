@page
@model ApTutor.ContentAdmin.Pages.IndexModel
@{
    ViewData["Title"] = "Content review";
}

<div class="unit-header">
    <h1>Content review</h1>
    <a href="/CreateCourse" class="link-button">Create new course</a>
</div>
<p class="notice">Pick a topic to generate or review its content.</p>

@if (Model.Courses.Count == 0)
{
    <p class="notice">No courses exist yet.</p>
}

@foreach (var course in Model.Courses)
{
    <section class="card">
        <div class="unit-header">
            <h2>@course.DisplayName</h2>
            <a href="/GenerateUnit?course=@course.CourseId" class="link-button">Generate new unit</a>
        </div>
        @if (!course.HasStructure)
        {
            <p class="notice">This course has no unit structure yet — use "Generate new unit" above to add one before generating content.</p>
        }
        @foreach (var unit in course.Units)
        {
            var notStartedCount = unit.Nodes.Count(n => n.Status == ApTutor.ContentAdmin.Pages.NodeReviewStatus.NotStarted);
            <div class="unit-header">
                <p class="unit-heading">Unit @unit.Unit — @unit.Title</p>
                @if (notStartedCount > 0)
                {
                    <form method="post" asp-page-handler="GenerateUnit" asp-route-course="@course.CourseId" asp-route-unit="@unit.Unit" class="generate-unit-form">
                        <button type="submit" class="link-button">Generate remaining (@notStartedCount)</button>
                    </form>
                }
            </div>
            <ul class="node-list">
                @foreach (var node in unit.Nodes)
                {
                    <li class="node-row">
                        <a href="/Review?course=@course.CourseId&node=@node.NodeId">@node.Title</a>
                        @switch (node.Status)
                        {
                            case ApTutor.ContentAdmin.Pages.NodeReviewStatus.Generating:
                                <span class="badge badge-pending">Generating…</span>
                                break;
                            case ApTutor.ContentAdmin.Pages.NodeReviewStatus.PendingReview:
                                <span class="badge badge-pending">Pending review</span>
                                break;
                            case ApTutor.ContentAdmin.Pages.NodeReviewStatus.Live:
                                <span class="badge badge-live">Live</span>
                                break;
                            default:
                                <span class="badge badge-empty">Not started</span>
                                break;
                        }
                    </li>
                }
            </ul>
        }
    </section>
}
