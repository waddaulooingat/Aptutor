@page
@model ApTutor.ContentAdmin.Pages.AiAgentModel
@{
    ViewData["Title"] = "AI Content Agent";
}

<div class="unit-header">
    <h1>AI Content Agent</h1>
    <a href="/" class="link-button">&larr; Back to content review</a>
</div>

<p class="notice">
    This is an explicit, temporary stopgap for while no human subject-matter expert is available to
    review content — <strong>not</strong> a permanent replacement for human review. It can (1) scan a
    course for nodes/difficulties with no approved practice items yet, and nodes with no learn content
    yet, generating both itself, and (2) has an AI reviewer pass that auto-approves or flags generated
    drafts, whether triggered by a scan or by a person clicking Generate. Content it approves is tagged
    <code>AiReviewed</code> everywhere it's stored — never indistinguishable from human-verified
    content — specifically so a future human SME can find and re-review it.
</p>

@if (!Model.Enabled)
{
    <p class="error">
        Currently <strong>disabled</strong> (<code>AiContentAgent:Enabled</code> is false). Generation
        completes and sits pending for a human, exactly as it always has — no AI review runs, and a scan
        below won't do anything until this is turned on in configuration.
    </p>
}
else
{
    <p class="notice">Currently <strong>enabled</strong>. A scan triggers up to @Model.MaxGenerationsPerScan generation(s) per run.</p>
}

@if (Model.Notice is not null)
{
    <p class="notice">@Model.Notice</p>
}

@if (Model.Courses.Count == 0)
{
    <p class="notice">No courses exist yet.</p>
}

@foreach (var course in Model.Courses)
{
    <section class="card">
        <div class="unit-header">
            <h2>@course.DisplayName</h2>
            <form method="post" asp-page-handler="RunScan" asp-route-course="@course.CourseId">
                <button type="submit" class="link-button" disabled="@(!Model.Enabled || course.GapCount == 0)">
                    Run scan (@course.GapCount gap(s))
                </button>
            </form>
        </div>
        @if (course.AiReviewedVersionCount > 0)
        {
            <p class="notice">
                <span class="badge badge-pending">@course.AiReviewedVersionCount AI-reviewed</span>
                approved version(s) in this course are awaiting a human SME re-review (cumulative,
                across every version ever approved — see the list below for what's live right now).
            </p>
        }
        @if (course.AiTouchedItems.Count > 0)
        {
            <details style="margin-top: 12px;">
                <summary class="course-summary" style="font-size: 1rem;">
                    @course.AiTouchedItems.Count currently-live item(s) the AI touched — click to view
                </summary>
                <table style="width: 100%; margin-top: 8px; border-collapse: collapse;">
                    <thead>
                        <tr style="text-align: left; border-bottom: 1px solid var(--border);">
                            <th style="padding: 4px 8px 4px 0;">Node</th>
                            <th style="padding: 4px 8px;">Content</th>
                            <th style="padding: 4px 8px;">AI-generated</th>
                            <th style="padding: 4px 8px;">AI-reviewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in course.AiTouchedItems.OrderBy(i => i.NodeId, StringComparer.Ordinal).ThenBy(i => i.ContentType, StringComparer.Ordinal))
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 4px 8px 4px 0;">
                                    <a href="/Review?course=@course.CourseId&node=@item.NodeId@(item.Difficulty is { } d ? $"&difficulty={d}" : "")">
                                        @item.NodeId — @item.NodeTitle
                                    </a>
                                </td>
                                <td style="padding: 4px 8px;">@item.ContentType@(item.Difficulty is { } diff ? $" ({diff})" : "")</td>
                                <td style="padding: 4px 8px;">@(item.AiGenerated ? "✓" : "")</td>
                                <td style="padding: 4px 8px;">@(item.AiReviewed ? "✓" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </section>
}
