@page
@model ApTutor.ContentAdmin.Pages.ReviewModel
@{
    ViewData["Title"] = Model.NodeTitle;
}

<p><a href="/">&larr; Back to topics</a></p>
<h1>@Model.NodeTitle</h1>
<p class="notice">@Model.CourseDisplayName</p>

<div class="difficulty-tabs">
    @foreach (var d in new[] { ApTutor.Content.Difficulty.Easy, ApTutor.Content.Difficulty.Medium, ApTutor.Content.Difficulty.Hard })
    {
        <a href="/Review?course=@Model.CourseId&node=@Model.NodeId&difficulty=@d"
           class="difficulty-tab @(d == Model.Difficulty ? "difficulty-tab-active" : "")">@d</a>
    }
</div>

@if (Model.Error is not null)
{
    <p class="error">@Model.Error</p>
}
@if (Model.Notice is not null)
{
    <p class="notice">@Model.Notice</p>
}

@if (Model.Pack is null)
{
    <div class="card">
        <p>Nothing has been generated for this topic at @Model.Difficulty difficulty yet.</p>
        <form method="post" asp-page-handler="Generate">
            <input type="hidden" name="course" value="@Model.CourseId" />
            <input type="hidden" name="node" value="@Model.NodeId" />
            <input type="hidden" name="difficulty" value="@Model.Difficulty" />
            <label>
                <input type="checkbox" name="allowGraphChoices" value="true" />
                Allow graph-based answer options (e.g. velocity-vs-time plots) — for Physics/Chemistry-style questions
            </label>
            <button type="submit" class="btn-primary">Generate</button>
        </form>
    </div>
}
else if (!Model.PackIsPending)
{
    <div class="card">
        <p>
            <span class="badge badge-live">Live</span>
            @if (Model.Pack.AiReviewed)
            {
                <span class="badge badge-pending" title="Approved by the AI reviewer, not a human — see the AI Content Agent page.">AI-reviewed</span>
            }
            This topic's content has been approved and is already in the app.
        </p>
        <h2>Explanation</h2>
        <p>@Model.Pack.WalkthroughText</p>

        <div class="actions" style="margin-top: 16px;">
            <form method="post" asp-page-handler="Generate">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <label>
                    <input type="checkbox" name="allowGraphChoices" value="true" />
                    Allow graph-based answer options
                </label>
                <button type="submit">Generate another set</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="card">
        <p>
            <span class="badge badge-pending">Pending review</span>
            @if (Model.Pack.AiGenerated)
            {
                <span class="badge badge-pending" title="Generation was triggered by the AI Content Agent's scan, not a person.">AI-generated</span>
            }
        </p>
        @if (Model.AiReviewNote is not null)
        {
            <p class="error">⚠ AI reviewer flagged this for human review: @Model.AiReviewNote</p>
        }
        <h2>Explanation</h2>
        <p>@Model.Pack.WalkthroughText</p>

        <h2>Practice questions</h2>
        <form method="post" asp-page-handler="Approve">
            <input type="hidden" name="course" value="@Model.CourseId" />
            <input type="hidden" name="node" value="@Model.NodeId" />
            <input type="hidden" name="difficulty" value="@Model.Difficulty" />

            @foreach (var item in Model.Pack.PracticeItems)
            {
                <div class="card">
                    <p><strong>@item.Prompt</strong></p>
                    @for (var i = 0; i < item.Choices.Count; i++)
                    {
                        <p class="choice @(i == item.CorrectIndex ? "correct" : "")">
                            @(i == item.CorrectIndex ? "✓" : "—")
                            @(item.Choices[i].IsGraph ? "[Graph-based answer — review rendering not built yet]" : item.Choices[i].Text)
                        </p>
                    }
                    <p class="notice">@item.Explanation</p>

                    <label>
                        <input type="checkbox" name="keep_@item.Id" value="true" checked />
                        Keep this question
                    </label>
                    <label for="reason_@item.Id">If discarding, why? (required if unchecked)</label>
                    <textarea id="reason_@item.Id" name="reason_@item.Id" rows="2"></textarea>
                </div>
            }

            <div class="actions">
                <button type="submit" class="btn-approve">Approve</button>
            </div>
        </form>

        <details style="margin-top: 16px;">
            <summary>Reject the whole topic instead</summary>
            <form method="post" asp-page-handler="Reject" style="margin-top: 10px;">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
            <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <label for="reason">Why are you rejecting this?</label>
                <textarea id="reason" name="reason" rows="3" required></textarea>
                <div class="actions">
                    <button type="submit" class="btn-reject">Reject</button>
                </div>
            </form>
        </details>

        <div class="actions" style="margin-top: 16px;">
            <form method="post" asp-page-handler="Generate">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <label>
                    <input type="checkbox" name="allowGraphChoices" value="true" />
                    Allow graph-based answer options
                </label>
                <button type="submit">Generate a new attempt</button>
            </form>
        </div>
    </div>
}

<h2>Learn content <span style="font-weight: normal; color: gray; font-size: 0.8em;">(not difficulty-specific — same for every difficulty tab)</span></h2>

@if (Model.LearnError is not null)
{
    <p class="error">@Model.LearnError</p>
}
@if (Model.LearnNotice is not null)
{
    <p class="notice">@Model.LearnNotice</p>
}

@if (Model.LearnContent is null)
{
    <div class="card">
        <p>No learn content has been generated for this topic yet.</p>
        <form method="post" asp-page-handler="GenerateLearn">
            <input type="hidden" name="course" value="@Model.CourseId" />
            <input type="hidden" name="node" value="@Model.NodeId" />
            <input type="hidden" name="difficulty" value="@Model.Difficulty" />
            <button type="submit" class="btn-primary">Generate learn content</button>
        </form>
    </div>
}
else if (!Model.LearnContentIsPending)
{
    <div class="card">
        <p>
            <span class="badge badge-live">Live</span>
            @if (Model.LearnContent.AiReviewed)
            {
                <span class="badge badge-pending" title="Approved by the AI reviewer, not a human — see the AI Content Agent page.">AI-reviewed</span>
            }
            This topic's learn content has been approved and is already in the app.
        </p>
        <p>@Model.LearnContent.Overview</p>
        <ol>
            @foreach (var step in Model.LearnContent.Steps)
            {
                <li>
                    <strong>@step.Caption</strong>
                    @if (!string.IsNullOrWhiteSpace(step.Detail))
                    {
                        <p>@step.Detail</p>
                    }
                </li>
            }
        </ol>

        <div class="actions" style="margin-top: 16px;">
            <form method="post" asp-page-handler="GenerateLearn">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <button type="submit">Generate another attempt</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="card">
        <p>
            <span class="badge badge-pending">Pending review</span>
            @if (Model.LearnContent.AiGenerated)
            {
                <span class="badge badge-pending" title="Generation was triggered by the AI Content Agent's scan, not a person.">AI-generated</span>
            }
        </p>
        @if (Model.LearnAiReviewNote is not null)
        {
            <p class="error">⚠ AI reviewer flagged this for human review: @Model.LearnAiReviewNote</p>
        }
        <p>@Model.LearnContent.Overview</p>
        <ol>
            @foreach (var step in Model.LearnContent.Steps)
            {
                <li>
                    <strong>@step.Caption</strong>
                    @if (!string.IsNullOrWhiteSpace(step.Detail))
                    {
                        <p>@step.Detail</p>
                    }
                </li>
            }
        </ol>

        <form method="post" asp-page-handler="ApproveLearn">
            <input type="hidden" name="course" value="@Model.CourseId" />
            <input type="hidden" name="node" value="@Model.NodeId" />
            <input type="hidden" name="difficulty" value="@Model.Difficulty" />
            <div class="actions">
                <button type="submit" class="btn-approve">Approve</button>
            </div>
        </form>

        <details style="margin-top: 16px;">
            <summary>Reject this learn content instead</summary>
            <form method="post" asp-page-handler="RejectLearn" style="margin-top: 10px;">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <label for="learnReason">Why are you rejecting this?</label>
                <textarea id="learnReason" name="learnReason" rows="3" required></textarea>
                <div class="actions">
                    <button type="submit" class="btn-reject">Reject</button>
                </div>
            </form>
        </details>

        <div class="actions" style="margin-top: 16px;">
            <form method="post" asp-page-handler="GenerateLearn">
                <input type="hidden" name="course" value="@Model.CourseId" />
                <input type="hidden" name="node" value="@Model.NodeId" />
                <input type="hidden" name="difficulty" value="@Model.Difficulty" />
                <button type="submit">Generate a new attempt</button>
            </form>
        </div>
    </div>
}
