@page
@model ApTutor.ContentAdmin.Pages.CreatingCourseModel
@{
    ViewData["Title"] = "Creating course";
    if (Model.IsRunning)
    {
        <meta http-equiv="refresh" content="2" />
    }
}

<p><a href="/">&larr; Back to topics</a></p>

@if (Model.IsRunning)
{
    <div class="card">
        <p class="spinner-text">Drafting the unit list&hellip; this page will refresh on its own.</p>
    </div>
}
else
{
    <div class="card">
        <p class="error">Generation failed: @Model.Error</p>
        <p><a href="/CreateCourse">Go back and try again</a></p>
    </div>
}
