<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApTutor.Tracer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ANTLR4 community Java grammar (antlr/grammars-v4, java/java, BSD license), generated
         to C# at build time. CLAUDE-HANDOFF/PHASE3-HANDOFF explicitly rule out hand-rolling a
         parser: parse full Java, then reject out-of-subset constructs in CedSubsetValidator. -->
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Grammar\JavaLexer.g4">
      <Visitor>true</Visitor>
      <Listener>false</Listener>
    </Antlr4>
    <Antlr4 Include="Grammar\JavaParser.g4">
      <Visitor>true</Visitor>
      <Listener>false</Listener>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApTutor.Scene\ApTutor.Scene.csproj" />
  </ItemGroup>

</Project>
