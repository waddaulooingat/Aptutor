<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApTutor.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- User-facing product name (Windows taskbar tooltip, file properties) — "Tutor AI", the
         brand name. RootNamespace/project name stay ApTutor.* for now; that's a separate, larger
         internal rename, deliberately not done in the same pass as this one. -->
    <AssemblyTitle>Tutor AI</AssemblyTitle>
    <Product>Tutor AI</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 7: ApTutor.ContentFactory writes verified content packs here in source (so they're
         stable across clean/rebuild, not lost like a bin/ output would be); this copies them into
         the build output next to the exe, which is where CsaCourseModule's default contentDir
         (AppContext.BaseDirectory/content/<courseId>) actually looks at runtime. -->
    <Content Include="content\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApTutor.Platform\ApTutor.Platform.csproj" />
    <ProjectReference Include="..\ApTutor.Curriculum\ApTutor.Curriculum.csproj" />
    <ProjectReference Include="..\ApTutor.Scene\ApTutor.Scene.csproj" />
    <ProjectReference Include="..\ApTutor.Tracer.Csa\ApTutor.Tracer.Csa.csproj" />
    <ProjectReference Include="..\ApTutor.Narration\ApTutor.Narration.csproj" />
    <ProjectReference Include="..\ApTutor.Content\ApTutor.Content.csproj" />
    <!-- Dev-only "Refresh questions" right-click (see MainWindow.axaml.cs): reuses
         ApTutor.ContentFactory's ClaudeClient/Generator to regenerate a single node's practice
         items live. Only reachable if ANTHROPIC_API_KEY/ANTHROPIC_MODEL are set — nothing calls
         the API on its own, and no key ships with the app. -->
    <ProjectReference Include="..\ApTutor.ContentFactory\ApTutor.ContentFactory.csproj" />
  </ItemGroup>

</Project>
