<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ApTutor.Client"
        xmlns:platform="using:ApTutor.Platform"
        x:Class="ApTutor.Client.MainWindow"
        Title="Tutor AI"
        Width="1100" Height="720">
  <Grid RowDefinitions="Auto,*" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <ComboBox Name="CourseSelector" SelectionChanged="OnCourseSelectionChanged" VerticalAlignment="Center" MinWidth="160">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="platform:ICourseModule">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Progress:" VerticalAlignment="Center" />
      <ProgressBar Name="MasteryProgressBar" Width="240" Minimum="0" Maximum="100" VerticalAlignment="Center" />
      <TextBlock Name="ProgressLabel" VerticalAlignment="Center" />
      <Button Name="MockExamButton" Content="Mock Exam" Click="OnMockExamClick" Margin="24,0,0,0" />
      <Button Name="RefreshContentButton" Content="Refresh content" Click="OnRefreshContentClick" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="320,8,*">

      <TreeView Name="UnitTree" Grid.Column="0" SelectionChanged="OnTreeSelectionChanged">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="local:ITreeItem" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Display}" Foreground="{Binding Foreground}">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <!-- Tag binds explicitly to the row's data item (UnitGroupVm or NodeItemVm) —
                       the handler no-ops for anything that isn't a NodeItemVm, e.g. a unit header. -->
                  <MenuItem Header="Refresh questions (dev)" Click="OnRefreshQuestionsClick" Tag="{Binding}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

      <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="16" CornerRadius="6">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Name="DetailTitle" FontSize="18" FontWeight="Bold" Text="Select a node" />
            <TextBlock Name="DetailType" />
            <TextBlock Name="DetailPrereqs" TextWrapping="Wrap" />
            <TextBlock Name="DetailViz" TextWrapping="Wrap" />
            <Button Name="MarkMasteredButton" Content="Mark mastered" Click="OnMarkMasteredClick" IsEnabled="False" />

            <Separator Margin="0,8,0,0" />
            <TextBlock Text="Content" FontWeight="Bold" Margin="0,4,0,0" />
            <StackPanel Name="ContentPanel" Spacing="8" />
          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</Window>
