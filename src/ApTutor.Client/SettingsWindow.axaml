<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApTutor.Client.SettingsWindow"
        Title="Settings"
        Width="480" Height="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="8">
      <TextBlock
        Text="Saved locally on this machine only, for dev/SME use — a plain environment variable always overrides these if set."
        TextWrapping="Wrap" Foreground="Gray" FontSize="12" />

      <TextBlock Text="Anthropic API key" FontWeight="Bold" Margin="0,8,0,0" />
      <TextBox Name="AnthropicApiKeyBox" PasswordChar="•" />

      <TextBlock Text="Anthropic model" FontWeight="Bold" />
      <TextBox Name="AnthropicModelBox" />

      <TextBlock Text="Content S3 bucket" FontWeight="Bold" />
      <TextBox Name="ContentBucketBox" />

      <TextBlock Text="Content S3 region" FontWeight="Bold" />
      <TextBox Name="ContentRegionBox" />

      <TextBlock Text="AWS access key ID (read-only content credential)" FontWeight="Bold" />
      <TextBox Name="AwsAccessKeyIdBox" />

      <TextBlock Text="AWS secret access key (read-only content credential)" FontWeight="Bold" />
      <TextBox Name="AwsSecretAccessKeyBox" PasswordChar="•" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
        <Button Name="SaveButton" Content="Save" Click="OnSaveClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
