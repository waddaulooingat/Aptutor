<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApTutor.Client.ProgressChartWindow"
        Title="Progress"
        Width="640" Height="360"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <TextBlock Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="Bold" />
    <TextBlock Grid.Row="1" Text="Accuracy by week — gray bars mean no practice that week, not a low score."
               Foreground="Gray" FontSize="12" Margin="0,2,0,12" TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Name="ChartPanel" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom" />
    </ScrollViewer>
  </Grid>
</Window>
