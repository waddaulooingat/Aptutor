<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApTutor.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Native Skia binaries for the off-screen renderer test; referencing all three keeps the
         test project runnable on whichever OS actually builds it. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApTutor.Curriculum\ApTutor.Curriculum.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.Platform\ApTutor.Platform.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.Scene\ApTutor.Scene.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.Tracer.Csa\ApTutor.Tracer.Csa.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.Narration\ApTutor.Narration.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.Content\ApTutor.Content.csproj" />
    <ProjectReference Include="..\..\src\ApTutor.ContentFactory\ApTutor.ContentFactory.csproj" />
  </ItemGroup>

</Project>
