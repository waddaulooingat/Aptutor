{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ContentAdminReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::tutor-ai-content/*"
    },
    {
      "Sid": "ContentAdminListScoped",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tutor-ai-content",
      "Condition": { "StringLike": { "s3:prefix": ["manifest.json", "courses/*"] } }
    }
  ]
}